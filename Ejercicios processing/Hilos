// Variables para la animación fluida
float angulo = 0;

// Variables para el estado del trabajo pesado
String estado = "Presiona el mouse para cargar los archivos del juego";
int porcentaje = 0;
boolean cargando = false;

void setup() {
  size(400, 300);
  textAlign(CENTER, CENTER);
  textSize(16);
}

void draw() {
  background(40);
 
  // ==========================================
  // 1. ANIMACIÓN  (Hilo Principal)
  pushMatrix();
  translate(width/2, height/2 - 40);
  rotate(angulo);
  rectMode(CENTER);
  fill(100, 200, 255);
  rect(0, 0, 80, 80);
  popMatrix();
 
  angulo += 0.05; 
 
  // ==========================================
  // 2. TEXTO 

  fill(255);
  text(estado, width/2, height - 80);
 

  if (cargando) {
    noFill();
    stroke(255);
    rectMode(CORNER);
    rect(50, height - 40, 300, 15); // Borde de la barra
   
    fill(100, 255, 100);
    noStroke();

    float anchoBarra = map(porcentaje, 0, 100, 0, 300);
    rect(50, height - 40, anchoBarra, 15);
  }
}

void mousePressed() {

  if (!cargando) {
    thread("cargarArchivos");
   
  }
}

// ==========================================
// 3. TAREA PESADA LOCAL (Hilo Secundario)
void cargarArchivos() {
  cargando = true;
  porcentaje = 0;
  estado = "Leyendo disco duro...";
 
  // Simulamos un proceso que toma tiempo, en 5 pasos.
  // Por ejemplo: procesar 5 imágenes gigantes o leer datos muy pesados.
  for (int i = 0; i <= 100; i += 20) {
    porcentaje = i;
   
    // delay() pausa ESTE hilo (el secundario), pero el draw() sigue vivo.
    // Simulamos que tarda 1 segundo en procesar cada parte.
    delay(1000);
  }
 
  estado = "¡Carga de archivos completada!";
  cargando = false;
}


